{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f*)",
      "Edit(**/.env)",
      "Edit(**/.worktreeinclude)",
      "Read(**/.env)"
    ]
  }
}
